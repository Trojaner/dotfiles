{
  "env": {
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "defaultMode": "default"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "prisma@claude-plugins-official": true,
    "mongodb@claude-plugins-official": true
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "extraKnownMarketplaces": {
    "camoufox-mcp": {
      "source": {
        "source": "github",
        "repo": "whit3rabbit/camoufox-mcp"
      }
    },
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    },
    "googlechrome": {
      "source": {
        "source": "github",
        "repo": "GoogleChrome/modern-web-guidance"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    },
    "agricidaniel-claude-seo": {
      "source": {
        "source": "github",
        "repo": "AgriciDaniel/claude-seo"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "effortLevel": "medium",
  "theme": "dark",
  "prefersReducedMotion": false,
  "editorMode": "normal",
  "verbose": false,
  "askUserQuestionTimeout": "never",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": true,
  "preferredNotifChannel": "terminal_bell",
  "agentPushNotifEnabled": true,
  "worktree": {
    "baseRef": "head",
    "bgIsolation": "none"
  },
  "awaySummaryEnabled": false,
  "dialogExpiry": "never",
  "feedbackDrafts": "off",
  "fileCheckpointingEnabled": true,
  "inputNeededNotifEnabled": true,
  "model": "opus[1m]",
  "promptSuggestionEnabled": false,
  "showThinkingSummaries": true,
  "skipWorkflowUsageWarning": true,
  "tui": "fullscreen"
}
